  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie 11",
    "not op_mini all"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "i18n/en-US.yml": [
      "yaml-sort --quotingStyle double --input"
    ]
  },
  "jest": {
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "react-map-gl/maplibre": "@vis.gl/react-maplibre",
      "util/api-base$": "<rootDir>__tests__/test-utils/mock-data/api-base.js",
      "util/debug-log$": "<rootDir>__tests__/test-utils/mock-data/debug-log.js",
      "util/go-mode/onboard-discovery$": "<rootDir>__tests__/test-utils/mock-data/onboard-discovery.js",
      "i18n/(.*)\\.yml$": "<rootDir>__tests__/test-utils/mock-data/empty-yml.js",
      "modeSettings.yml$": "<rootDir>__tests__/test-utils/mock-data/empty-yml.js",
      "i18n-loader": "<rootDir>__tests__/test-utils/mock-data/i18n-loader.js",
      "\\.graphql$": "<rootDir>__tests__/test-utils/mock-data/empty-string.js",
      "\\.css$": "<rootDir>__tests__/test-utils/mock-data/empty-string.js",
      "\\.(jpg|ico|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>__tests__/test-utils/mock-data/fileMock.js"
    },
    "transform": {
      "\\.[jt]sx?$": "babel-jest"
    },
    "testMatch": [
      "**/__tests__/**/*.[jt]s?(x)",
      "**/*.test.[jt]s?(x)"
    ],
    "rootDir": "./",
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/__tests__/test-utils"
    ],
    "setupFilesAfterEnv": [
      "@wordpress/jest-puppeteer-axe",
      "<rootDir>__tests__/test-utils/setup-env.js"
    ],
    "testEnvironmentOptions": {
      "url": "http://localhost:9966"
    },
    "globalSetup": "<rootDir>__tests__/test-utils/global-setup.js"
  }
}
